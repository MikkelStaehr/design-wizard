{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MikkelStaehr/design-wizard/contracts/tokens.v1.schema.json",
  "title": "Design Wizard tokens.json v1 (W3C DTCG 2025.10 subset, docs/CONTRACTS.md section 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$description",
    "$extensions",
    "color",
    "font",
    "font-size",
    "line-height",
    "radius",
    "space"
  ],
  "properties": {
    "$description": {
      "type": "string",
      "minLength": 1
    },
    "$extensions": {
      "type": "object",
      "required": [
        "com.github.mikkelstaehr.design-wizard"
      ],
      "properties": {
        "com.github.mikkelstaehr.design-wizard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "project",
            "theme"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "project": {
              "type": "string",
              "minLength": 1
            },
            "theme": {
              "const": "light"
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg",
        "surface",
        "border",
        "text",
        "text-muted",
        "accent",
        "on-accent",
        "positive",
        "warning",
        "negative",
        "focus"
      ],
      "properties": {
        "bg": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "text-muted": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "on-accent": {
          "$ref": "#/$defs/color"
        },
        "positive": {
          "$ref": "#/$defs/color"
        },
        "warning": {
          "$ref": "#/$defs/color"
        },
        "negative": {
          "$ref": "#/$defs/color"
        },
        "focus": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "text"
      ],
      "properties": {
        "display": {
          "$ref": "#/$defs/fontFamily"
        },
        "text": {
          "$ref": "#/$defs/fontFamily"
        }
      }
    },
    "font-size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xs",
        "sm",
        "base",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ],
      "properties": {
        "xs": {
          "$ref": "#/$defs/dimRem"
        },
        "sm": {
          "$ref": "#/$defs/dimRem"
        },
        "base": {
          "$ref": "#/$defs/dimRem"
        },
        "lg": {
          "$ref": "#/$defs/dimRem"
        },
        "xl": {
          "$ref": "#/$defs/dimRem"
        },
        "2xl": {
          "$ref": "#/$defs/dimRem"
        },
        "3xl": {
          "$ref": "#/$defs/dimRem"
        }
      }
    },
    "line-height": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "display"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/lineHeight"
        },
        "display": {
          "$ref": "#/$defs/lineHeight"
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/dimPx"
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3",
        "4",
        "6",
        "8",
        "12",
        "16"
      ],
      "properties": {
        "1": {
          "$ref": "#/$defs/dimPx"
        },
        "2": {
          "$ref": "#/$defs/dimPx"
        },
        "3": {
          "$ref": "#/$defs/dimPx"
        },
        "4": {
          "$ref": "#/$defs/dimPx"
        },
        "6": {
          "$ref": "#/$defs/dimPx"
        },
        "8": {
          "$ref": "#/$defs/dimPx"
        },
        "12": {
          "$ref": "#/$defs/dimPx"
        },
        "16": {
          "$ref": "#/$defs/dimPx"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$type",
        "$value"
      ],
      "properties": {
        "$type": {
          "const": "color"
        },
        "$value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorSpace",
            "components",
            "alpha",
            "hex"
          ],
          "properties": {
            "colorSpace": {
              "const": "srgb"
            },
            "components": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "alpha": {
              "const": 1
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            }
          }
        }
      }
    },
    "dimPx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$type",
        "$value"
      ],
      "properties": {
        "$type": {
          "const": "dimension"
        },
        "$value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "unit": {
              "const": "px"
            }
          }
        }
      }
    },
    "dimRem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$type",
        "$value"
      ],
      "properties": {
        "$type": {
          "const": "dimension"
        },
        "$value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 6
            },
            "unit": {
              "const": "rem"
            }
          }
        }
      }
    },
    "lineHeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$type",
        "$value"
      ],
      "properties": {
        "$type": {
          "const": "number"
        },
        "$value": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "fontFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$type",
        "$value",
        "$extensions"
      ],
      "properties": {
        "$type": {
          "const": "fontFamily"
        },
        "$value": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "enum": [
                "sans-serif",
                "serif",
                "monospace"
              ]
            }
          ],
          "items": false,
          "minItems": 2
        },
        "$extensions": {
          "type": "object",
          "required": [
            "com.github.mikkelstaehr.design-wizard"
          ],
          "properties": {
            "com.github.mikkelstaehr.design-wizard": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "catalogueId",
                "fontsource",
                "weights",
                "style",
                "subset",
                "license",
                "copyright"
              ],
              "properties": {
                "catalogueId": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "fontsource": {
                  "type": "string",
                  "pattern": "^@fontsource/"
                },
                "weights": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 900
                  }
                },
                "style": {
                  "const": "normal"
                },
                "subset": {
                  "const": "latin"
                },
                "license": {
                  "const": "OFL-1.1"
                },
                "copyright": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
