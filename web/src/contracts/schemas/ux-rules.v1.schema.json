{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MikkelStaehr/design-wizard/contracts/ux-rules.v1.schema.json",
  "title": "Design Wizard ux-rules.yaml v1 (docs/CONTRACTS.md section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "law",
        "when",
        "rule",
        "severity",
        "check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "law": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "must",
            "should"
          ]
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "selector",
            "params",
            "viewports"
          ],
          "properties": {
            "kind": {
              "enum": [
                "min-target-size",
                "max-count",
                "contrast",
                "response-time",
                "focus-visible",
                "manual"
              ]
            },
            "selector": {
              "type": [
                "string",
                "null"
              ]
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "viewports": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 320,
                "maximum": 2560
              }
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\?$"
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "question"
            ],
            "properties": {
              "selector": {
                "type": "null"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "question"
              ]
            },
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "viewports": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
